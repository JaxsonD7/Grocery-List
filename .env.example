# Firebase config (Project Settings → General → Your apps → SDK setup and configuration).
# Copy this file to .env.local and fill in your values. If these are left
# unset, the app falls back to local-only (browser storage) mode with no
# accounts or cloud sync.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
